    \field{abstract}{%
    [This paper examines the consequences and detection of model
  misspecification when using maximum likelihood techniques for estimation and
  inference. The quasi-maximum likelihood estimator (OMLE) converges to a well
  defined limit, and may or may not be consistent for particular parameters of
  interest. Standard tests (Wald, Lagrange Multiplier, or Likelihood Ratio) are
  invalid in the presence of misspecification, but more general statistics are
  given which allow inferences to be drawn robustly. The properties of the QMLE
  and the information matrix are exploited to yield several useful tests for
  model misspecification.]%
    }
    \field{number}{1}
    \field{pages}{1\bibrangedash 25}
    \field{title}{Maximum Likelihood Estimation of Misspecified Models}
    \field{volume}{50}
    \field{journaltitle}{Econometrica}
    \field{year}{1982}
